[Unit]
Description=skid, voice output for the agents
Documentation=file://%h/.projects/skid/docs/PROJECT.md
Requires=skid.socket
After=skid.socket

[Service]
# notify rather than simple, so "active" and "can answer" are the same
# statement. skid sends READY=1 once kokoro is loaded, which takes tens of
# seconds on a cold start and would otherwise leave the first caller waiting on
# a service systemd already called started.
Type=notify
NotifyAccess=main
ExecStart=%h/.local/bin/skid

# Started on the first connection and restarted if it dies, so a caller meets a
# wait rather than a dead socket. FR-5.3 still bounds the wait, because a
# process can be running and not answering.
Restart=on-failure
RestartSec=1

# The model is held warm for the life of the process. An idle timeout would
# make FR-5.1's warm model sometimes-warm, so there is not one.
TimeoutStartSec=300

[Install]
WantedBy=default.target
