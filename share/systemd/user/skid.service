[Unit]
Description=skid, voice output for the agents
Documentation=file://%h/.projects/skid/docs/PROJECT.md
Requires=skid.socket
After=skid.socket

# Chosen, where these were systemd's defaults of 5 in 10s. Ten attempts over two
# minutes: long enough that a slow-failing loop latches instead of running for
# ever, short enough that a permanent fault is off and visible rather than
# burning restarts.
#
# The default was worse than it looks and in a way worth writing down. It
# latches on FAST failures and not on slow ones, so an import error stops after
# 7 seconds while the spaCy episode restarted 76 times without ever tripping it,
# each attempt outliving the 10 second window. Widening the interval is what
# makes the slow case latch too.
#
# Latching is deliberate. `systemctl --user status skid.service` says failed,
# and `reset-failed` clears it once the cause is fixed.
#
# This section and not the service one: systemd moved these in v229 and IGNORES
# them there with a warning, while `systemd-analyze verify` still exits 0.
# Measured 2026-08-28 by writing them in the wrong place and reading the output.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
# notify rather than simple, so "active" and "can answer" are the same
# statement. skid sends READY=1 once kokoro is loaded, which takes tens of
# seconds on a cold start and would otherwise leave the first caller waiting on
# a service systemd already called started.
Type=notify
NotifyAccess=main
ExecStart=%h/.local/bin/skid

# Started on the first connection and restarted if it dies, so a caller meets a
# wait rather than a dead socket. FR-5.3 still bounds the wait, because a
# process can be running and not answering.
Restart=on-failure
RestartSec=1

# skid pings only while the serve loop is getting somewhere: idle counts, a clip
# on the speaker counts, and generation is covered by a 60s grace. Withholding
# the ping is the mechanism, so this catches a wedged loop rather than a dead
# process, which Restart= already handles.
#
# 120s, and not tuned to clip length. A clip can legitimately play for 77
# seconds (measured 2026-08-28, 1196 characters) and that does not bound this,
# because playback pings. What it must clear is one generation step: about 30
# seconds for the longest clip the player's own 300s ceiling admits.
WatchdogSec=120

# The model is held warm for the life of the process. An idle timeout would
# make FR-5.1's warm model sometimes-warm, so there is not one.
TimeoutStartSec=300

[Install]
WantedBy=default.target
