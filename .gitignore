# Session entry point: ephemeral by design, rewritten each session.
START_HERE.md

# In-process and working files, including the message a commit is given with
# -F. Gitignored so that naming it on the command line can never put it into
# the commit it describes.
.ephemera/
__pycache__/
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
*.egg-info/

# What a gate run leaves behind. bolt writes .bolt-<iso8601> at the run base by
# default, and the python jig declares coverage.xml as evidence.
.bolt-*/
coverage.xml
.coverage

# The adopted jigs and the checkers they name, linked into toolbox. A committed
# copy would be a second statement of one thing, free to drift from the file it
# was copied from.
#
# bolt.skid.definitions.yaml is NOT one of these and is tracked: it is skid's
# own, not toolbox's, and it is what points the common jig at a requirements
# directory instead of the retired single file.
bolt.*-quality.yaml
bin/*.py
adapters/
